+		lspc_waited  <= 0;
+		lspc_dly     <= 0;
+	end else begin
+		if (lspc_hold) lspc_waited  <= 1;
+		else           lspc_granted <= 1;
+		if (lspc_granted && lspc_dly != 2'd3) lspc_dly <= lspc_dly + 2'd1;
+	end
